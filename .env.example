# Bing IndexNow domain-ownership token (not secret).
# Generate at https://www.bing.com/webmasters then IndexNow then Generate API key.
# Used by scripts/indexnow.ts (runs as the postbuild npm script).
# Add this in Vercel: Project Settings then Environment Variables (Production + Preview + Development).
INDEXNOW_KEY=

# --- Contact form email (Resend) ---------------------------------------------
# Resend API key. Create one at https://resend.com then API Keys.
# SECRET — never commit the real value. Add in Vercel + your local .env.local.
RESEND_API_KEY=

# Where contact-form leads are delivered. Defaults to info@rankpointmedia.com.
CONTACT_TO_EMAIL=info@rankpointmedia.com

# The "from" address shown on the lead email. The domain (rankpointmedia.com)
# must be verified in Resend (Domains then add domain then add the DNS records)
# or sends will fail. While testing before verification, you may temporarily use
# "Rank Point Media <onboarding@resend.dev>" (delivers only to your Resend
# account's own email).
CONTACT_FROM_EMAIL=Rank Point Media <forms@rankpointmedia.com>
